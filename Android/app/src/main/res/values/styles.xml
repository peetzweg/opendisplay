<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3, light/dark following the system; dynamic color on 12+. -->
    <style name="Theme.OpenDisplay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Preference dialogs (the name editor) take the activity theme: Material 3. -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Full-screen sheets (settings, log): not floating, on the surface color. -->
    <style name="Theme.OpenDisplay.Sheet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <!-- Preference dialogs (the name editor) in Material 3, not AppCompat grey. -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
