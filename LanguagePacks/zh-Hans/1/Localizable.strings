"Starting…" = "正在启动…";
"Preparing virtual display…" = "正在准备虚拟显示器…";
"Display blocked by saved macOS state — trying a fresh identity…" = "显示器被 macOS 记住的旧状态挡住了——正在换一个新身份重试…";
"Screen Recording permission needed — see Permissions below" = "需要屏幕录制权限——见下方「权限」";
"Extending — grant Accessibility for touch input" = "正在扩展——请授权辅助功能以使用触摸输入";
"Connected to %@" = "已连接到 %@";
"Capture could not be restarted" = "无法重新启动画面采集";

/* MARK: Footer, logs, updates */

"Logs" = "日志";
"Reveal the OpenDisplay log files in Finder" = "在访达中显示 OpenDisplay 的日志文件";
"Quit" = "退出";
"Check for Updates…" = "检查更新…";

