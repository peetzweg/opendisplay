"Extending to %@" = "正在扩展到 %@";
"Mirroring to %@" = "正在镜像到 %@";
"Connection lost — retrying for %@s…" = "连接已断开，正在尝试重连（%@ 秒）…";
"Failed: %@" = "连接失败：%@";
"Waiting for the device to connect…" = "正在等待设备连接…";
"Device found — open the OpenDisplay app on it…" = "已找到设备，请在设备上打开 OpenDisplay…";
"Waiting for a USB device — plug in the iPhone or iPad…" = "正在等待 USB 设备，请连接 iPhone 或 iPad…";
"Waiting for the Android device — plug it in…" = "正在等待 Android 设备，请用 USB 线连接…";
"Unlock the Android device to connect over USB…" = "请解锁 Android 设备以通过 USB 连接…";
"Install OpenDisplay on the Android device and allow it to use the USB accessory" = "请在 Android 设备上安装 OpenDisplay 并允许它使用 USB 配件";

